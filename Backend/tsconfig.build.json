{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": [
    "server.ts",
    "Genre.ts",
    "config/**/*.ts",
    "entities/**/*.ts",
    "errors/**/*.ts",
    "interfaces/**/*.ts",
    "migrations/**/*.ts",
    "repositories/**/*.ts",
    "services/**/*.ts",
    "validators/**/*.ts"
  ]
}
